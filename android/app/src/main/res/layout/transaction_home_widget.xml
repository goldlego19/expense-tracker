<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_panel" android:scaleType="fitXY" android:contentDescription="@null" />
        <!-- A single-row viewport keeps accounts separate while allowing vertical swipes. -->
        <ListView android:id="@+id/widget_accounts" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" android:overScrollMode="never"
            android:padding="0dp" android:clipToPadding="true" android:contentDescription="Accounts. Swipe up or down to change account." />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:text="Open Pocket Ledger to set up" android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
