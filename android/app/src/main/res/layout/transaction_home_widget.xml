<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_panel" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POCKET LEDGER" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.13" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <StackView android:id="@+id/widget_stack" android:layout_width="match_parent" android:layout_height="match_parent" android:loopViews="true" android:animateFirstView="false" />
            <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:text="Open Pocket Ledger to set up" android:textSize="14sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_previous" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="25sp" android:contentDescription="Previous account" />
            <TextView android:id="@+id/widget_swipe_hint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="Swipe up / down to cycle" android:textSize="10sp" />
            <TextView android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="25sp" android:contentDescription="Next account" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
